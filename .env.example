PORT=3000
# Existing deployments: keep your current MONGO_URI. Changing the db name points at an empty DB.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/intvoicekit?retryWrites=true&w=majority

# Optional. LiveKit Agents API host. Defaults to the production host when unset.
# EXTERNAL_API_BASE=https://api-livekit-vyom.indusnettechnologies.com


# Optional. Comma-separated DNS servers used instead of the system resolver, for machines
# whose resolver cannot look up the mongodb+srv record (e.g. WSL). Leave unset in deploys.
# DNS_SERVERS=8.8.8.8,1.1.1.1
